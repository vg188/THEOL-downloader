{
  "manifest_version": 3,
  "name": "北化课件助手",
  "version": "1.0.1",
  "minimum_chrome_version": "120",
  "description": "在北化 THEOL 教学平台扫描当前课件列表，勾选批量下载 PDF、PPT、PPTX 原文件。非官方、本地运行。",
  "permissions": ["scripting", "downloads", "storage"],
  "host_permissions": ["https://course.buct.edu.cn/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "北化课件助手",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
}
